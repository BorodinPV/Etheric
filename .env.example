# Etheric OAuth 2.0 Server — environment variables
#
# Copy to .env and adjust values for your environment.
# Do NOT commit .env to version control (see .gitignore).

# PostgreSQL
ETHERIC_DB_USER=etheric
ETHERIC_DB_PASSWORD=change-me-strong-db-password
ETHERIC_DB_REACTIVE_URL=postgresql://localhost:5432/etheric
ETHERIC_DB_JDBC_URL=jdbc:postgresql://localhost:5432/etheric

# Redis
ETHERIC_REDIS_URL=redis://localhost:6379

# Admin API (required in production — must differ from default)
ETHERIC_ADMIN_API_KEY=change-me-to-a-long-random-secret

# JWT issuer claim (iss)
ETHERIC_JWT_ISSUER=https://auth.example.com

# CORS — disabled by default in production
# Set ETHERIC_CORS_ENABLED=true only when serving SPA clients from other origins.
ETHERIC_CORS_ENABLED=false
# Comma-separated list of allowed origins (never use * with credentials)
# ETHERIC_CORS_ORIGINS=https://app.example.com,https://admin.example.com
